#!/usr/bin/env python3
import os
import json
import shutil
import subprocess
import sys
import time

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib, Gio
except Exception as exc:
    print(f"twodrive-tray: Gtk3 is required: {exc}", file=sys.stderr)
    sys.exit(1)

APPINDICATOR_AVAILABLE = False
try:
    gi.require_version("AppIndicator3", "0.1")
    from gi.repository import AppIndicator3
    APPINDICATOR_AVAILABLE = True
except Exception:
    try:
        gi.require_version("AyatanaAppIndicator3", "0.1")
        from gi.repository import AyatanaAppIndicator3 as AppIndicator3
        APPINDICATOR_AVAILABLE = True
    except Exception:
        AppIndicator3 = None


def twodrive_bin():
    return shutil.which("twodrive") or os.path.expanduser("~/.local/bin/twodrive")


def data_dir():
    return os.path.join(
        os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
        "twodrive",
    )


def activity_path():
    return os.path.join(data_dir(), "activity.json")


def run_detached(*args):
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def capture_status():
    try:
        result = subprocess.run(
            [twodrive_bin(), "status"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=5,
            check=False,
        )
        return result.stdout.strip() or "No status output"
    except Exception as exc:
        return f"Status unavailable: {exc}"


def read_activity():
    path = activity_path()
    try:
        with open(path, "r", encoding="utf-8") as handle:
            snapshot = json.load(handle)
    except Exception:
        return []

    now = int(time.time())
    active = []
    for item in snapshot.get("active", []):
        updated = int(item.get("updated_unix") or item.get("started_unix") or 0)
        if now - updated > 6 * 60 * 60:
            continue
        if item.get("kind") not in ("upload", "download"):
            continue
        active.append(item)
    return active


def format_bytes(value):
    if value is None:
        return ""
    try:
        value = float(value)
    except Exception:
        return ""
    units = ["B", "KiB", "MiB", "GiB"]
    for unit in units:
        if value < 1024 or unit == units[-1]:
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024
    return ""


def activity_label(item):
    kind = item.get("kind", "sync")
    verb = "Uploading" if kind == "upload" else "Downloading"
    name = item.get("name") or os.path.basename(item.get("path", "")) or "(unknown)"
    done = item.get("bytes_done")
    total = item.get("bytes_total")
    if total:
        return f"{verb}: {name} ({format_bytes(done)} / {format_bytes(total)})"
    if done:
        return f"{verb}: {name} ({format_bytes(done)})"
    return f"{verb}: {name}"


class Tray:
    def __init__(self):
        self.paused = False
        self.last_status = "token: unknown"
        self.next_status_check = 0
        self.refresh_timer = None
        self.activity_monitor = None
        self.status_item = Gtk.MenuItem(label="Status: starting")
        self.status_item.set_sensitive(False)
        self.transfer_header = Gtk.MenuItem(label="Sync: idle")
        self.transfer_header.set_sensitive(False)
        self.transfer_items = []
        self.indicator = None
        self.status_icon = None
        self.menu = self.build_menu()

        if APPINDICATOR_AVAILABLE:
            self.indicator = AppIndicator3.Indicator.new(
                "twodrive",
                "folder-cloud",
                AppIndicator3.IndicatorCategory.APPLICATION_STATUS,
            )
            self.indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
            self.indicator.set_menu(self.menu)
        else:
            self.status_icon = Gtk.StatusIcon.new_from_icon_name("folder-cloud")
            self.status_icon.set_tooltip_text("TwoDrive")
            self.status_icon.connect("popup-menu", self.on_popup)

        self.setup_activity_monitor()
        self.refresh_status()

    def build_menu(self):
        menu = Gtk.Menu()
        open_item = Gtk.MenuItem(label="Open TwoDrive folder")
        open_item.connect("activate", lambda *_: run_detached(twodrive_bin(), "open-folder"))
        menu.append(open_item)
        menu.append(self.status_item)
        menu.append(self.transfer_header)

        for _ in range(5):
            item = Gtk.MenuItem(label="")
            item.set_sensitive(False)
            item.hide()
            self.transfer_items.append(item)
            menu.append(item)

        pause_item = Gtk.CheckMenuItem(label="Pause sync")
        pause_item.connect("toggled", self.on_pause)
        menu.append(pause_item)

        sync_item = Gtk.MenuItem(label="Sync now")
        sync_item.connect("activate", lambda *_: run_detached(twodrive_bin(), "sync"))
        menu.append(sync_item)

        prune_item = Gtk.MenuItem(label="Release unpinned cache")
        prune_item.connect("activate", lambda *_: run_detached(twodrive_bin(), "cache", "prune"))
        menu.append(prune_item)

        settings_item = Gtk.MenuItem(label="Settings")
        settings_item.connect("activate", lambda *_: run_detached("twodrive-settings"))
        menu.append(settings_item)

        quit_item = Gtk.MenuItem(label="Quit tray")
        quit_item.connect("activate", lambda *_: Gtk.main_quit())
        menu.append(quit_item)

        stop_item = Gtk.MenuItem(label="Quit tray and stop sync")
        stop_item.connect("activate", self.on_stop_sync)
        menu.append(stop_item)

        menu.show_all()
        for item in self.transfer_items:
            item.hide()
        return menu

    def setup_activity_monitor(self):
        try:
            os.makedirs(data_dir(), exist_ok=True)
            directory = Gio.File.new_for_path(data_dir())
            self.activity_monitor = directory.monitor_directory(Gio.FileMonitorFlags.NONE, None)
            self.activity_monitor.connect("changed", self.on_activity_changed)
        except Exception as exc:
            print(f"twodrive-tray: activity monitor unavailable: {exc}", file=sys.stderr)

    def on_activity_changed(self, _monitor, file_obj, _other, _event):
        if file_obj and file_obj.get_basename() == "activity.json":
            GLib.idle_add(self.refresh_status)

    def on_popup(self, icon, button, activate_time):
        self.menu.popup(None, None, None, None, button, activate_time)

    def on_pause(self, item):
        self.paused = item.get_active()
        self.refresh_status()

    def on_stop_sync(self, *_):
        run_detached("systemctl", "--user", "stop", "twodrive-daemon.service")
        Gtk.main_quit()

    def set_icon(self, icon_name):
        if self.indicator:
            self.indicator.set_icon_full(icon_name, "TwoDrive")
        if self.status_icon:
            self.status_icon.set_from_icon_name(icon_name)

    def schedule_refresh(self, active):
        if self.refresh_timer is not None:
            try:
                GLib.source_remove(self.refresh_timer)
            except Exception:
                pass
            self.refresh_timer = None
        interval_ms = 1500 if active else 60000
        self.refresh_timer = GLib.timeout_add(interval_ms, self.refresh_status)

    def maybe_refresh_status_text(self, active):
        now = time.monotonic()
        interval = 30 if active else 300
        if now < self.next_status_check:
            return
        status_lines = capture_status().splitlines()
        self.last_status = next(
            (line for line in status_lines if line.startswith("token:")),
            "token: unknown",
        )
        self.next_status_check = now + interval

    def update_transfer_menu(self, active_items):
        if not active_items:
            self.transfer_header.set_label("Sync: idle")
            for item in self.transfer_items:
                item.hide()
            return

        count = len(active_items)
        self.transfer_header.set_label(f"Syncing: {count} item(s)")
        for index, item in enumerate(self.transfer_items):
            if index < count:
                item.set_label(activity_label(active_items[index]))
                item.show()
            else:
                item.hide()

    def refresh_status(self):
        active_items = read_activity()
        active = bool(active_items)
        self.maybe_refresh_status_text(active)
        self.update_transfer_menu(active_items)

        if self.paused:
            label = "Status: paused"
            icon = "media-playback-pause"
        elif active:
            label = "Status: syncing"
            icon = "emblem-twodrive-syncing"
        else:
            label = f"Status: {self.last_status}"
            icon = "folder-cloud"

        self.status_item.set_label(label)
        if self.indicator:
            self.indicator.set_title(label)
        if self.status_icon:
            self.status_icon.set_tooltip_text(label)
        self.set_icon(icon)
        self.schedule_refresh(active)
        return False


if __name__ == "__main__":
    tray = Tray()
    Gtk.main()
