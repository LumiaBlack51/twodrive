#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys

try:
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk
except Exception as exc:
    print(f"twodrive-settings: Gtk4 is required: {exc}", file=sys.stderr)
    sys.exit(1)

try:
    gi.require_version("Adw", "1")
    from gi.repository import Adw
    ADW_AVAILABLE = True
except Exception:
    Adw = None
    ADW_AVAILABLE = False


def twodrive_bin():
    return shutil.which("twodrive") or os.path.expanduser("~/.local/bin/twodrive")


def run_status():
    try:
        result = subprocess.run(
            [twodrive_bin(), "status"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=5,
            check=False,
        )
        return result.stdout
    except Exception as exc:
        return f"status error: {exc}"


def run_known_folder_status():
    try:
        result = subprocess.run(
            [twodrive_bin(), "known-folders", "status"], text=True,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5, check=False,
        )
        if result.returncode:
            raise RuntimeError(result.stderr.strip() or "Upload source checks failed")
        data = json.loads(result.stdout)
        if not isinstance(data.get("folders"), list):
            raise ValueError("Invalid upload source status")
        return data
    except Exception as exc:
        return {"folders": [], "error": str(exc)}


def save_known_folder_source(folder, path):
    try:
        result = subprocess.run(
            [twodrive_bin(), "known-folders", "set-source", str(folder["index"]),
             path, "--expected-local", folder["configured_local"]],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=5, check=False,
        )
        return result.returncode == 0, (result.stdout if result.returncode == 0 else result.stderr).strip()
    except Exception as exc:
        return False, str(exc)


def cache_size(path):
    total = 0
    for root, _, files in os.walk(os.path.expanduser(path)):
        for name in files:
            try:
                total += os.path.getsize(os.path.join(root, name))
            except OSError:
                pass
    return total


def human_size(value):
    units = ["B", "KiB", "MiB", "GiB", "TiB"]
    size = float(value)
    for unit in units:
        if size < 1024 or unit == units[-1]:
            return f"{size:.1f} {unit}"
        size /= 1024


class SettingsApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.twodrive.Settings")

    def do_activate(self):
        if ADW_AVAILABLE:
            Adw.init()
        window = Gtk.ApplicationWindow(application=self)
        window.set_title("TwoDrive Settings")
        window.set_default_size(720, 700)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(18)
        box.set_margin_bottom(18)
        box.set_margin_start(18)
        box.set_margin_end(18)

        status = run_status()
        fields = {}
        for line in status.splitlines():
            if ":" in line:
                key, value = line.split(":", 1)
                fields[key.strip()] = value.strip()

        rows = [
            ("Login state", fields.get("token", "unknown")),
            ("Sync folder", fields.get("mount", os.path.expanduser("~/TwoDrive/OneDrive"))),
            ("Cache path", fields.get("cache", os.path.expanduser("~/.local/share/twodrive/cache"))),
            ("Cache used", human_size(cache_size(fields.get("cache", "~/.local/share/twodrive/cache")))),
            ("Pinned used", "Shown after pinned-size accounting is added"),
            ("Cache retain for", fields.get("cache retain", "30d")),
            ("Cache max size", fields.get("cache max", "20GiB")),
            ("Battery sync interval", fields.get("sync interval battery", "60m")),
            ("AC sync interval", fields.get("sync interval ac", "15m")),
        ]

        title = Gtk.Label(label="TwoDrive Settings")
        title.add_css_class("title-1")
        title.set_xalign(0)
        box.append(title)

        for label, value in rows:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            left = Gtk.Label(label=label)
            left.set_xalign(0)
            left.set_hexpand(True)
            right = Gtk.Label(label=value)
            right.set_xalign(1)
            right.set_wrap(True)
            row.append(left)
            row.append(right)
            box.append(row)

        sources_title = Gtk.Label(label="Upload sources")
        sources_title.add_css_class("title-3")
        sources_title.set_xalign(0)
        box.append(sources_title)
        sources = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.append(sources)
        self.refresh_sources(sources, window)

        refresh = Gtk.Button(label="Refresh upload sources")
        refresh.connect("clicked", lambda *_: self.refresh_sources(sources, window))
        box.append(refresh)

        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        window.set_child(scroll)
        window.present()

    def refresh_sources(self, box, window, notice=None):
        while box.get_first_child():
            box.remove(box.get_first_child())
        data = run_known_folder_status()
        if "error" in data:
            self.source_label(box, "Cannot check upload sources: " + data["error"])
            return
        self.source_label(box, "Uploads enabled" if data.get("enabled") else "Uploads disabled")
        if data.get("mode") != "upload_only":
            self.source_label(box, "Configured upload mode is unsupported; uploads are inactive.")
        self.source_label(box, "After saving a source, restart TwoDrive to apply it. System special directories are configured separately.")
        if notice:
            self.source_label(box, notice)
        if not data["folders"]:
            self.source_label(box, "No upload sources configured.")
        for folder in data["folders"]:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            details.set_hexpand(True)
            self.source_label(details, folder["local"] + " → " + folder["remote"])
            self.source_label(details, folder["message"])
            if folder.get("system_directory"):
                self.source_label(details, "System directory: " + folder["system_directory"])
            for warning in folder.get("warnings", []):
                self.source_label(details, warning)
            row.append(details)
            choose = Gtk.Button(label="Choose source…")
            choose.connect("clicked", lambda _, item=folder: self.choose_source(item, box, window))
            row.append(choose)
            box.append(row)

    @staticmethod
    def source_label(box, text):
        label = Gtk.Label(label=text)
        label.set_xalign(0)
        label.set_wrap(True)
        label.set_selectable(True)
        box.append(label)

    def choose_source(self, folder, box, window):
        chooser = Gtk.FileChooserNative.new(
            "Choose local upload source", window, Gtk.FileChooserAction.SELECT_FOLDER,
            "Save source", "Cancel",
        )
        # Keep the native chooser alive until its response is handled.
        window.source_chooser = chooser

        def selected(dialog, response):
            if response == Gtk.ResponseType.ACCEPT:
                selected_file = dialog.get_file()
                path = selected_file.get_path() if selected_file else None
                if path:
                    success, message = save_known_folder_source(folder, path)
                    self.refresh_sources(box, window, ("Saved. " if success else "Unable to save. ") + message)
                else:
                    self.refresh_sources(box, window, "Choose a local filesystem directory.")
            dialog.destroy()
            window.source_chooser = None

        chooser.connect("response", selected)
        chooser.show()


if __name__ == "__main__":
    SettingsApp().run(sys.argv)
